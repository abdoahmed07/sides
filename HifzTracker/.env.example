# Copy to .env.local and fill in. Never commit .env.local.

# Your Anthropic API key (server-side only; never sent to the browser).
ANTHROPIC_API_KEY=

# Model used by /api/plan-assistant. Default: claude-opus-5-5.
# A cheaper option for this app is claude-haiku-5-5.
ANTHROPIC_MODEL=claude-opus-5-5

# Request timeout in milliseconds (default 60000).
# ANTHROPIC_TIMEOUT_MS=60000

# Optional: sign-in and sync between devices (Supabase). Leave empty to keep
# everything on this device only. Run supabase/schema.sql in the project first.
# Supabase → Project Settings → API: the project URL and the anon (public) key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
